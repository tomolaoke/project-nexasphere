# Copy this file to .streamlit/secrets.toml for local use, or paste the
# same key into the "Secrets" box when deploying on Streamlit Community
# Cloud (Settings -> Secrets). Never commit the real secrets.toml file.
#
# Get a free Groq API key (no credit card required) at:
#   https://console.groq.com/keys
#
# Without this key, the app still works perfectly -- it just narrates
# findings with the deterministic template instead of an AI model.

GROQ_API_KEY = "gsk_your_key_here"
